{
  "name": "@peppol-sh/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the peppol.sh Peppol API: Peppol e-invoicing (UBL, EN 16931) for TypeScript and JavaScript.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check --config-path=biome.jsonc .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:types": "openapi-typescript ../../apps/api/src/openapi.yaml -o src/generated/types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^22",
    "openapi-typescript": "^7",
    "typescript": "^5",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peppol-sh/peppol-sh-ts.git"
  },
  "homepage": "https://github.com/peppol-sh/peppol-sh-ts#readme",
  "bugs": {
    "url": "https://github.com/peppol-sh/peppol-sh-ts/issues"
  },
  "keywords": [
    "peppol",
    "e-invoicing",
    "ubl",
    "einvoice"
  ]
}
